# build output
bin/
obj/
artifacts/

# ...except this one, which is source: it is the npm package's bin directory,
# named by npm's convention rather than by .NET's, and `bin/` above hides it.
# Re-including the directory is what makes the file inside visible; git cannot
# re-include a file whose parent directory is still excluded.
!packaging/npm/bin/

# IDE
.vs/
.idea/
*.user

# local-only working docs (never commit specs/plans)
docs/superpowers/

# ffmpeg binaries are downloaded, never committed
tools/ffmpeg/

# release artifacts
dist/
/design/

# benchmark results (BenchmarkDotNet writes here; never committed)
BenchmarkDotNet.Artifacts/

# TUnit 1.65+ writes an HTML and a JSON report here on every test run.
TestResults/
