<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal per-machine installer for the Spektra GUI. Installs the single
  self-contained spektra.exe to Program Files, adds a Start Menu shortcut, and
  registers an Add/Remove Programs entry. Build from the repo root after
  publishing the GUI to dist\gui-win-x64:

    wix extension add -g WixToolset.UI.wixext
    wix extension add -g WixToolset.Util.wixext
    wix build packaging\spektra.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext -o dist\artifacts\Spektra-<version>-Setup.msi

  Building with -arch x64 makes ProgramFiles6432Folder resolve to the real
  Program Files (not the x86 folder) for the 64-bit app.
  The UpgradeCode must stay constant across versions so upgrades replace in place.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- Mirrors Spektra.Core BandwidthReport.AudioExtensions. Keep in sync: the
       audit pipeline and the shell verbs should agree on what counts as audio. -->
  <?define AudioExts=.flac;.mp3;.wav;.ogg;.opus;.m4a;.aac;.wma;.ape;.wv;.aiff;.aif;.alac?>
  <Package Name="Spektra" Manufacturer="rarepops" Version="!(bind.FileVersion.spektraExe)"
           UpgradeCode="3F6E162E-15A4-4C40-A0B7-F0CEA4176DF3"
           Scope="perMachine" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Spektra is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\spektra.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/rarepops/Spektra" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Spektra" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SpektraMenuFolder" Name="Spektra" />
    </StandardDirectory>

    <Feature Id="Main" Title="Spektra" Level="1" AllowAbsent="no"
             Description="The Spektra application and its Start Menu shortcut.">
      <Component Id="MainExe" Directory="INSTALLFOLDER">
        <File Id="spektraExe" Source="dist\gui-win-x64\spektra.exe" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcut" Directory="SpektraMenuFolder">
        <Shortcut Id="AppShortcut" Name="Spektra"
                  Target="[INSTALLFOLDER]spektra.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="UninstallShortcut" Name="Uninstall Spektra"
                  Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]"
                  Description="Remove Spektra from this computer" Icon="AppIcon" />
        <RemoveFolder Id="RemoveSpektraMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\rarepops\Spektra" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- The downloaded ffmpeg always goes on a real uninstall: it is a
           runtime-fetched dependency rather than user data, it is the largest
           thing left behind, and the app can fetch it again. NOT
           UPGRADINGPRODUCTCODE is the other half of that "real uninstall":
           MajorUpgrade's RemoveExistingProducts runs the old package's own
           InstallExecuteSequence, REMOVE=ALL, as part of every
           version-to-version upgrade, with UPGRADINGPRODUCTCODE set in that
           session. Without the guard this row fires there too, so every
           update would delete the ffmpeg download and force a re-download on
           next launch, with no dialog and nothing to restore it (the folder
           was never MSI-owned). UPGRADINGPRODUCTCODE is set in exactly that
           one situation, so it is the only condition that discriminates;
           REMOVE="ALL" is not usable here because the upgrade-removal session
           also runs with REMOVE=ALL. -->
      <Component Id="RemoveDownloadedFfmpeg" Directory="INSTALLFOLDER">
        <util:RemoveFolderEx On="uninstall" Property="SPEKTRAFFMPEGDIR" Condition="NOT UPGRADINGPRODUCTCODE" />
        <RegistryValue Root="HKLM" Key="Software\rarepops\Spektra" Name="FfmpegCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Settings, palettes, and the analysis cache: only on request. The gate
           sits on the RemoveFolderEx row, not on the component. A component
           whose condition is false is never installed, so at uninstall time it
           is not "being removed" and its removal would never fire, making the
           checkbox a no-op. The row condition is evaluated during the uninstall
           itself, which is when the checkbox has actually been answered.
           AND NOT UPGRADINGPRODUCTCODE excludes the same upgrade-triggered
           removal session as the ffmpeg row above. User data already survives
           an upgrade through other mechanisms, but the guard belongs on this
           row too so the invariant is explicit here rather than something a
           future maintainer has to re-derive from those other mechanisms. -->
      <Component Id="RemoveUserData" Directory="INSTALLFOLDER">
        <util:RemoveFolderEx On="uninstall" Property="SPEKTRAAPPDATA" Condition="REMOVEUSERDATA AND NOT UPGRADINGPRODUCTCODE" />
        <RegistryValue Root="HKLM" Key="Software\rarepops\Spektra" Name="UserDataCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Optional: add the install folder to the system PATH so "spektra" can be
         launched from a terminal. Shown as a toggle on the Custom Setup page and
         removed again on uninstall. -->
    <Feature Id="PathFeature" Title="Add to PATH" Level="1"
             Description="Add Spektra to the system PATH so you can launch it by typing &quot;spektra&quot; in a terminal.">
      <Component Id="PathEntry" Directory="INSTALLFOLDER">
        <Environment Id="SpektraPath" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\rarepops\Spektra" Name="PathAdded"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- util:RemoveFolderEx resolves its folder from a property, and the
         Wix4RemoveFoldersEx action that reads it is itself scheduled before
         CostInitialize, so these have to be set earlier still. Scheduling them
         before CostFinalize instead is not merely late: an empty property makes
         that action return E_INVALIDARG and fail the whole transaction, so the
         package would not install at all. These are per-user paths, so they
         resolve for whoever runs the uninstall: a per-machine package cannot
         clean other profiles, and this deliberately does not pretend to.
         SPEKTRAFFMPEGDIR points at the ffmpeg subfolder specifically (matching
         FfmpegLocator.DownloadDir), not all of %LOCALAPPDATA%\Spektra: the
         dialog and the comment above only promise to remove "the ffmpeg
         download", and a wider value would silently start deleting anything
         else Spektra later writes under that root. SPEKTRAAPPDATA has no such
         narrowing: %APPDATA%\Spektra is itself the user-data root, nothing
         else lives under it, so removing the whole folder is exactly what the
         "remove settings, palettes, and the analysis cache" checkbox
         consents to, not an oversight. -->
    <SetProperty Id="SPEKTRAAPPDATA" Value="[AppDataFolder]Spektra" Before="CostInitialize" Sequence="both" />
    <SetProperty Id="SPEKTRAFFMPEGDIR" Value="[LocalAppDataFolder]Spektra\ffmpeg" Before="CostInitialize" Sequence="both" />

    <!-- Unticked by default. Public (uppercase) and Secure so it survives into
         the elevated context, and settable for scripted removal:
         msiexec /x <msi> REMOVEUSERDATA=1 /qn -->
    <Property Id="REMOVEUSERDATA" Secure="yes" />

    <!-- Optional Explorer integration: an Open With entry, an "Analyze with
         Spektra" verb on audio files, and a folder submenu. Level 1000 puts it
         above the package install level, so it is OFF unless the user turns it
         on in the Custom Setup page. It never becomes the default handler for
         any extension. -->
    <Feature Id="ShellIntegration" Title="Explorer integration" Level="1000"
             Description="Adds Spektra to the Explorer right-click menu for audio files and folders. Does not change which program opens your audio files.">

      <Component Id="ShellProgId" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKLM" Key="Software\Classes\rarepops.Spektra.1" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="Spektra audio file" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="[#spektraExe],0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#spektraExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="Software\rarepops\Spektra" Name="ShellIntegration"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ShellOpenWith" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\spektra.exe" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="Spektra" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#spektraExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <?foreach EXT in $(AudioExts)?>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\spektra.exe\SupportedTypes"
                       Name="$(var.EXT)" Type="string" Value="" />
        <!-- Joins the Open With list for this type without touching its default
             handler. Documented shape: ProgID as the value NAME, empty data. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\$(var.EXT)\OpenWithProgids"
                       Name="rarepops.Spektra.1" Type="string" Value="" />
        <?endforeach?>
        <RegistryValue Root="HKLM" Key="Software\rarepops\Spektra" Name="ShellOpenWith"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ShellFileVerb" Directory="INSTALLFOLDER">
        <?foreach EXT in $(AudioExts)?>
        <!-- SystemFileAssociations adds a verb without owning the association. -->
        <RegistryKey Root="HKLM" Key="Software\Classes\SystemFileAssociations\$(var.EXT)\shell\Spektra.Analyze"
                     ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="Analyze with Spektra" />
          <RegistryValue Name="Icon" Type="string" Value="[#spektraExe],0" />
          <!-- Player: the whole selection arrives as one process (tabs in one
               window, not a window each), up to Explorer's multi-select cap. -->
          <RegistryValue Name="MultiSelectModel" Type="string" Value="Player" />
          <RegistryValue Key="command" Type="string" Value="&quot;[#spektraExe]&quot; %*" />
        </RegistryKey>
        <?endforeach?>
        <RegistryValue Root="HKLM" Key="Software\rarepops\Spektra" Name="ShellFileVerb"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ShellFolderVerbs" Directory="INSTALLFOLDER">
        <!-- One cascading "Spektra" entry rather than three top-level rows.
             %1 is the folder for Directory\shell. -->
        <RegistryKey Root="HKLM" Key="Software\Classes\Directory\shell\Spektra" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="MUIVerb" Type="string" Value="Spektra" />
          <RegistryValue Name="Icon" Type="string" Value="[#spektraExe],0" />
          <RegistryValue Name="SubCommands" Type="string" Value="" />
          <RegistryValue Key="shell\01Open" Type="string" Value="Open in Spektra" />
          <RegistryValue Key="shell\01Open\command" Type="string" Value="&quot;[#spektraExe]&quot; &quot;%1&quot;" />
          <RegistryValue Key="shell\02Duplicates" Type="string" Value="Find duplicates" />
          <RegistryValue Key="shell\02Duplicates\command" Type="string" Value="&quot;[#spektraExe]&quot; --dupes &quot;%1&quot;" />
          <RegistryValue Key="shell\03Manifest" Type="string" Value="List folder contents" />
          <RegistryValue Key="shell\03Manifest\command" Type="string" Value="&quot;[#spektraExe]&quot; --manifest &quot;%1&quot;" />
        </RegistryKey>
        <!-- Same menu on the folder background (right-click empty space inside
             an open folder). %V is the folder there; %1 is not. -->
        <RegistryKey Root="HKLM" Key="Software\Classes\Directory\Background\shell\Spektra" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="MUIVerb" Type="string" Value="Spektra" />
          <RegistryValue Name="Icon" Type="string" Value="[#spektraExe],0" />
          <RegistryValue Name="SubCommands" Type="string" Value="" />
          <RegistryValue Key="shell\01Open" Type="string" Value="Open in Spektra" />
          <RegistryValue Key="shell\01Open\command" Type="string" Value="&quot;[#spektraExe]&quot; &quot;%V&quot;" />
          <RegistryValue Key="shell\02Duplicates" Type="string" Value="Find duplicates" />
          <RegistryValue Key="shell\02Duplicates\command" Type="string" Value="&quot;[#spektraExe]&quot; --dupes &quot;%V&quot;" />
          <RegistryValue Key="shell\03Manifest" Type="string" Value="List folder contents" />
          <RegistryValue Key="shell\03Manifest\command" Type="string" Value="&quot;[#spektraExe]&quot; --manifest &quot;%V&quot;" />
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="Software\rarepops\Spektra" Name="ShellFolderVerbs"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Wizard UI: welcome, license, a Custom Setup page (to toggle "Add to
         PATH"), progress, and a finish page. Without this a double-clicked MSI
         shows no dialogs and looks like it did nothing. -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\license.rtf" />

    <!-- Offer to start Spektra straight from the finish page. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Spektra now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#spektraExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64"
                  Impersonate="yes" Return="ignore" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />

      <!-- Asked only on the Remove path, between MaintenanceTypeDlg and
           VerifyReadyDlg. One checkbox, unticked by default. -->
      <Dialog Id="SpektraRemoveDataDlg" Width="370" Height="270" Title="Spektra Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="{\WixUI_Font_Title}Remove Spektra" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="Choose what to keep." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BodyText" Type="Text" X="20" Y="60" Width="330" Height="48" NoPrefix="yes"
                 Text="The ffmpeg download is always removed; Spektra can fetch it again. Your settings, custom palettes, and the analysis cache are kept unless you ask for them to go." />
        <Control Id="RemoveDataCheckBox" Type="CheckBox" X="20" Y="116" Width="330" Height="18"
                 Property="REMOVEUSERDATA" CheckBoxValue="1"
                 Text="Also remove settings, palettes, and the analysis cache" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Reroute Remove through the question. A higher Order than WixUI's own
           row is how the documented WixUI customization overrides navigation. -->
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog"
               Value="SpektraRemoveDataDlg" Order="10" Condition="1" />
    </UI>
  </Package>
</Wix>
