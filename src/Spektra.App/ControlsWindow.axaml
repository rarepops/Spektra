<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spektra.App.ControlsWindow"
        Title="Controls" Width="980" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterOwner" Background="#1A1A1A" CanResize="False">
  <Window.Styles>
    <Style Selector="TextBlock.group">
      <Setter Property="Foreground" Value="#9AA0A6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="Foreground" Value="#C9C9C9" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.desc">
      <Setter Property="Foreground" Value="#9A9A9A" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="#7E858C" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="#E8B0B0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Every group is the same two-column list, so the rows are one template
         fed six different lists rather than sixty hand-written TextBlocks. -->
    <Style Selector="ItemsControl.rows">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <DataTemplate x:Key="RowTemplate">
      <Grid ColumnDefinitions="155,*">
        <TextBlock Grid.Column="0" Classes="key" Text="{Binding Key}" />
        <TextBlock Grid.Column="1" Classes="desc" Text="{Binding Description}" />
      </Grid>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="RowsPanel">
      <StackPanel Spacing="6" />
    </ItemsPanelTemplate>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,16,0,0">
      <Button Content="Close" Click="OnClose" IsDefault="True" IsCancel="True" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,16,0,0">
      <TextBlock Classes="note"
                 Text="{Binding BindingsFile, StringFormat='Every key above except F1 can be changed: put a command and a key combination in {0} and restart Spektra.'}" />
      <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Classes="problem" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid ColumnDefinitions="*,36,*">

        <StackPanel Grid.Column="0" Spacing="16">

          <TextBlock Classes="group" Text="Files &amp; tabs" />
          <ItemsControl Classes="rows" ItemsSource="{Binding FilesAndTabs}"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsPanel="{StaticResource RowsPanel}" />

          <TextBlock Classes="group" Text="View &amp; zoom" />
          <ItemsControl Classes="rows" ItemsSource="{Binding ViewAndZoom}"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsPanel="{StaticResource RowsPanel}" />

          <TextBlock Classes="group" Text="Save &amp; export" />
          <ItemsControl Classes="rows" ItemsSource="{Binding SaveAndExport}"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsPanel="{StaticResource RowsPanel}" />

        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="16">

          <TextBlock Classes="group" Text="Analysis" />
          <ItemsControl Classes="rows" ItemsSource="{Binding Analysis}"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsPanel="{StaticResource RowsPanel}" />

          <TextBlock Classes="group" Text="Compare" />
          <ItemsControl Classes="rows" ItemsSource="{Binding Compare}"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsPanel="{StaticResource RowsPanel}" />

          <TextBlock Classes="group" Text="Tools &amp; right-click" />
          <ItemsControl Classes="rows" ItemsSource="{Binding Tools}"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsPanel="{StaticResource RowsPanel}" />

        </StackPanel>

      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
