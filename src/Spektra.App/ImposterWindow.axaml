<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Spektra.Core;assembly=Spektra.Core"
        x:Class="Spektra.App.ImposterWindow"
        Title="Imposter Buster" Width="1180" Height="700"
        Background="#111111" Foreground="#CCCCCC" FontSize="13"
        DragDrop.AllowDrop="True">
  <Window.Styles>
    <!-- Every text cell trims to its column and keeps the whole value in its
         tooltip, so a narrow column hides nothing for good. -->
    <Style Selector="TextBlock.cell">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="Margin" Value="12,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- A copy 10 s or more off its reference file's length takes the warning
         colour Duplicate Detective gives the same gap. -->
    <Style Selector="TextBlock.cell.lengthGap">
      <Setter Property="Foreground" Value="#E0A030" />
    </Style>
    <!-- The window sets this class on the confirmed rows while To hear is on
         show (OnLoadingRow), so the copies to hear stand out from the rows
         that only frame them. -->
    <Style Selector="DataGridRow.dim">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- On the row, as the folder grid does, so the whole row right-clicks;
         the one shared menu takes its DataContext from the row it opens on.
         Compare takes C rather than the R of "reference": Reveal holds R in
         every file menu of the app. -->
    <Style Selector="DataGridRow">
      <Setter Property="ContextMenu">
        <ContextMenu>
          <MenuItem Header="_Compare with the reference" Click="OnMenuCompareClicked"
                    IsEnabled="{Binding CanCompare}"
                    ToolTip.Tip="This copy and its reference file side by side in the main window, aligned · the reference is A" />
          <Separator />
          <MenuItem Header="_Open spectrogram" Click="OnMenuOpenClicked" />
          <MenuItem Header="Play in _default player" Click="OnMenuPlayClicked" />
          <MenuItem Header="Copy _path" Click="OnMenuCopyPathClicked" />
          <MenuItem Header="_Reveal in Explorer" Click="OnMenuRevealClicked" />
        </ContextMenu>
      </Setter>
    </Style>
  </Window.Styles>
  <!-- Bottom inset 4 (not 12) so the footer band matches the main window,
       whose status line sits 4px off the edge. -->
  <DockPanel Margin="12,12,12,4">
    <!-- The reference row on top, then the folders to check: the list absorbs
         the slack height the button column leaves, so the path box below it
         keeps its compact height. While a scan runs, everything that edits a
         folder disables: the run snapshotted the folders at start, so an edit
         would only desync what is shown from what the results cover. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <!-- Compact heights matching the 26px input boxes, as in the sibling
           windows. :is() also catches the DropDownButton, which derives from
           Button. -->
      <Grid.Styles>
        <Style Selector=":is(Button)">
          <Setter Property="MinHeight" Value="26" />
          <Setter Property="Padding" Value="10,3" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
      </Grid.Styles>
      <!-- Shows the reference folder AND accepts a new one, like the manifest's
           address bar. OneWay on purpose: Reference has a private setter, so a
           default (TwoWay) TextBox binding would try to write back and fail;
           OneWay keeps typing local until Enter. -->
      <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
        <TextBlock DockPanel.Dock="Left" Text="Reference" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="ReferenceBox" MinHeight="26" Padding="6,3" VerticalContentAlignment="Center"
                 Text="{Binding Reference, Mode=OneWay}" IsEnabled="{Binding !IsScanning}"
                 PlaceholderText="Paste or type the reference folder's path and press Enter"
                 KeyDown="OnReferenceKeyDown"
                 ToolTip.Tip="The folder you trust to hold the recordings you mean, such as a rip you made yourself · Enter sets it, Esc reverts an edit" />
      </DockPanel>
      <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,6" Content="Browse…" Click="OnBrowseReferenceClicked"
              HorizontalAlignment="Stretch" IsEnabled="{Binding !IsScanning}"
              ToolTip.Tip="Choose the reference folder" />
      <!-- 144 is what the six buttons beside the list (176px) leave above the
           path box's row, so the list fills its row; a longer list scrolls
           instead of growing the band. -->
      <ListBox x:Name="RootsList" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Roots}"
               MaxHeight="144" Background="#181818"
               ToolTip.Tip="The folders to check against the reference folder">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,2" />
          </Style>
        </ListBox.Styles>
      </ListBox>
      <TextBox x:Name="RootPathBox" Grid.Row="2" Grid.Column="0" Margin="0,6,0,0"
               MinHeight="26" Padding="6,3" VerticalContentAlignment="Center"
               IsEnabled="{Binding !IsScanning}"
               PlaceholderText="Paste or type a folder to check and press Enter"
               KeyDown="OnRootPathKeyDown"
               ToolTip.Tip="Adds the folder as a folder to check; dragging folders from Explorer works too" />
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1" Background="#2A2A2A"
              Margin="10,0" />
      <!-- No fixed width: the column takes its widest label, so every button
           shares that width whatever the system font. -->
      <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Spacing="4">
        <Button Content="Add folder…" Click="OnAddFolderClicked" HorizontalAlignment="Stretch"
                IsEnabled="{Binding !IsScanning}" />
        <Button Content="Remove" Click="OnRemoveFolderClicked" HorizontalAlignment="Stretch"
                IsEnabled="{Binding !IsScanning}" />
        <Button Content="Clear all" Click="OnClearFoldersClicked" HorizontalAlignment="Stretch"
                IsEnabled="{Binding !IsScanning}"
                ToolTip.Tip="Empty the folders to check and clear the last results · the reference folder stays" />
        <Button Content="Scan" Click="OnScanClicked" IsEnabled="{Binding CanScan}"
                IsVisible="{Binding !IsScanning}" HorizontalAlignment="Stretch" />
        <Button Content="Cancel" Click="OnCancelClicked" IsVisible="{Binding IsScanning}"
                HorizontalAlignment="Stretch" />
        <DropDownButton Content="Export" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        IsEnabled="{Binding CanExport}" PointerEntered="OnExportHover"
                        ToolTip.Tip="Hover to pick CSV or JSON · every row of the scan, whatever the view and the filter">
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="CSV rows" Tag="csv" Click="OnExportFormatClicked" />
              <MenuItem Header="JSON rows" Tag="json" Click="OnExportFormatClicked" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Content="Save listening playlist…" Click="OnSavePlaylistClicked" HorizontalAlignment="Stretch"
                IsEnabled="{Binding CanSavePlaylist}"
                ToolTip.Tip="The songs to hear as the filter leaves them, each song's copies and then its reference file, as an .m3u8 for your own player" />
      </StackPanel>
    </Grid>

    <!-- Splits the input bar from the results below; full-width via the
         negative margin that cancels the 12px inset. -->
    <Border DockPanel.Dock="Top" Height="1" Background="#2A2A2A" Margin="-12,0,-12,8" />

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsVisible="{Binding IsScanning}">
      <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Margin="12,0,0,0"
                 VerticalAlignment="Center" Foreground="#999999" FontSize="12" />
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="8" />
    </DockPanel>

    <!-- The views and the filter, only once there is a result for the labels
         to count. Each label counts the whole result, whatever the filter
         hides. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsVisible="{Binding HasResults}">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12" Margin="0,0,12,0"
                  VerticalAlignment="Center">
        <RadioButton GroupName="imposterView" Content="{Binding ToHearLabel}"
                     IsChecked="{Binding ShowToHear, Mode=TwoWay}"
                     ToolTip.Tip="Songs with a copy that is not confirmed as the reference recording, each as its reference file and then its copies" />
        <RadioButton GroupName="imposterView" Content="{Binding AllClearLabel}"
                     IsChecked="{Binding ShowAllClear, Mode=TwoWay}"
                     ToolTip.Tip="Songs whose every copy is confirmed as the reference recording" />
        <RadioButton GroupName="imposterView" Content="{Binding NoReferenceLabel}"
                     IsChecked="{Binding ShowNoReference, Mode=TwoWay}"
                     ToolTip.Tip="Files in the checked folders whose name no reference file shares" />
        <RadioButton GroupName="imposterView" Content="{Binding ReferenceOnlyLabel}"
                     IsChecked="{Binding ShowReferenceOnly, Mode=TwoWay}"
                     ToolTip.Tip="Reference files whose name no file in the checked folders shares" />
      </StackPanel>
      <TextBox MinHeight="26" Padding="6,3" VerticalContentAlignment="Center"
               Text="{Binding FilterText}"
               PlaceholderText="Filter by song or path, space separated"
               ToolTip.Tip="Every word must be in the path of a file the row stands for (for a song, any of its files); clear to show every row" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" Text="{Binding FooterText}"
               Foreground="#888888" FontSize="11" TextWrapping="Wrap" />

    <!-- Splits the results from the footer, mirroring the top-bar divider. -->
    <Border DockPanel.Dock="Bottom" Height="1" Background="#2A2A2A" Margin="-12,8,-12,0" />

    <!-- No star column: with one, the grid squeezed the columns after it to
         slivers rather than scroll. Every column has a width of its own, so a
         window narrower than the columns scrolls the grid sideways; every
         column resizes by its header edge, and the widths are remembered by
         header (ApplyColumnWidths, HarvestColumnWidths). The rows come from
         ShowRows rather than a binding, so the sort the user chose survives a
         new list; ShowRows finds the sorted column by its SortMemberPath,
         which every column therefore names. A tooltip with nothing to say is
         switched off rather than shown empty. -->
    <DataGrid x:Name="RowsGrid" IsReadOnly="True" AutoGenerateColumns="False"
              CanUserSortColumns="True" CanUserReorderColumns="False"
              CanUserResizeColumns="True" SelectionMode="Single"
              Background="#111111" FontSize="12"
              DoubleTapped="OnRowDoubleTapped" LoadingRow="OnLoadingRow">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="★" SortMemberPath="IsBest" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="★" Foreground="#D8B060" Margin="12,0"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding IsBest}"
                         ToolTip.Tip="The best real copy of this song" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Song" SortMemberPath="Song" Width="200">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Text="{Binding Song}" ToolTip.Tip="{Binding Song}"
                         ToolTip.ServiceEnabled="{Binding Song, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Folder" SortMemberPath="Folder" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Text="{Binding Folder}" ToolTip.Tip="{Binding FolderPath}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Grade" SortMemberPath="Grade" Width="230">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Text="{Binding Grade}" ToolTip.Tip="{Binding GradeTip}"
                         ToolTip.ServiceEnabled="{Binding GradeTip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Note" SortMemberPath="Note" Width="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Text="{Binding Note}" ToolTip.Tip="{Binding Note}"
                         ToolTip.ServiceEnabled="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Length" SortMemberPath="Seconds" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Classes.lengthGap="{Binding HasLengthGap}" Text="{Binding Length}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Quality" SortMemberPath="Quality" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Text="{Binding Quality}" ToolTip.Tip="{Binding Quality}"
                         ToolTip.ServiceEnabled="{Binding Quality, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- The short form fits the column; the full sentence is its tooltip. -->
        <DataGridTemplateColumn Header="Verdict" SortMemberPath="VerdictShort" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Text="{Binding VerdictShort}" ToolTip.Tip="{Binding Verdict}"
                         ToolTip.ServiceEnabled="{Binding Verdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="File" SortMemberPath="File" Width="200">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Classes="cell" Text="{Binding File}" ToolTip.Tip="{Binding Path}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
